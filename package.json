{
  "name": "pope-bot",
  "version": "0.1.0",
  "description": "Small Discord bot for my personal server",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --minify --format esm --shims",
    "deploy-commands": "tsx scripts/deploy-commands.ts",
    "get-links": "tsx scripts/get-links.ts",
    "get-updates": "tsx scripts/get-updates.ts",
    "update-db": "tsx scripts/update-db.ts",
    "get-user-stats": "tsx scripts/get-user-stats.ts",
    "get-images-from-discord": "npm run get-links && npm run get-updates && npm run update-db",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --check \"**/*.{ts,js,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Jakub-L/pope-bot.git"
  },
  "keywords": [
    "discord",
    "pope",
    "fun",
    "bot"
  ],
  "author": "Jakub L.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Jakub-L/pope-bot/issues"
  },
  "homepage": "https://github.com/Jakub-L/pope-bot#readme",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "cloudflare": "^4.3.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "sharp": "^0.34.2",
    "sharp-phash": "^2.2.0",
    "uuid": "^11.1.0"
  }
}
